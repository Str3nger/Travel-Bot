\# Utilizziamo un'immagine ufficiale Python 3.10 basata su Debian slim (leggera e veloce) FROM python:3.10-slim # Impedisce a Python di scrivere file .pyc su disco e disattiva il buffering dell'stdout (log immediati) ENV PYTHONDONTWRITEBYTECODE=1 ENV PYTHONUNBUFFERED=1 # Imposta la directory di lavoro all'interno del container WORKDIR /app # Copia il file delle dipendenze per sfruttare la cache dei layer di Docker COPY requirements.txt /app/ # Installa le librerie senza salvare la cache di pip RUN pip install --no-cache-dir -r requirements.txt # Copia tutti i file del progetto nella directory di lavoro del container COPY . /app/ # Comando di avvio del bot CMD ["python", "main.py"]
